@model BudgetApp.Controllers.DashboardVm
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var c = Model.Comparison;
}

<h1 class="mb-3">Dashboard</h1>

@if (Model.TotalExpense > Model.TotalIncome)
{
    <div class="alert alert-warning">
        ⚠️ Dina utgifter är högre än inkomsterna för vald period.
    </div>
}

@if (Model.AnyOverBudget)
{
    <div class="alert alert-danger">
        🚨 Du ligger över budget i minst en kategori.
    </div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-2">
        <input type="number" class="form-control" name="month" min="1" max="12" value="@Model.Month" />
    </div>
    <div class="col-md-2">
        <input type="number" class="form-control" name="year" min="2000" max="2100" value="@Model.Year" />
    </div>
    <div class="col-md-8 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Visa period</button>
        <a class="btn btn-outline-dark"
           asp-action="Report"
           asp-route-month="@Model.Month"
           asp-route-year="@Model.Year"
           target="_blank">
            Öppna rapport (PDF)
        </a>
    </div>
</form>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h6 class="text-muted">Inkomster</h6>
                <h3 class="text-success">@Model.TotalIncome.ToString("C")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h6 class="text-muted">Utgifter</h6>
                <h3 class="text-danger">@Model.TotalExpense.ToString("C")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h6 class="text-muted">Saldo</h6>
                <h3 class="@(Model.Balance >= 0 ? "text-primary" : "text-warning")">@Model.Balance.ToString("C")</h3>
            </div>
        </div>
    </div>
</div>

<!-- Månadsjämförelse -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Månadsjämförelse</h5>
                <p class="text-muted mb-3">
                    @c.CurrentYear-@c.CurrentMonth.ToString("D2")
                    jämfört med
                    @c.PreviousYear-@c.PreviousMonth.ToString("D2")
                </p>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="text-end">Nuvarande månad</th>
                                <th class="text-end">Föregående månad</th>
                                <th class="text-end">Skillnad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Inkomster</td>
                                <td class="text-end">@c.CurrentIncome.ToString("C")</td>
                                <td class="text-end">@c.PreviousIncome.ToString("C")</td>
                                <td class="text-end @(c.IncomeDiff >= 0 ? "text-success" : "text-danger")">
                                    @c.IncomeDiff.ToString("C")
                                </td>
                            </tr>
                            <tr>
                                <td>Utgifter</td>
                                <td class="text-end">@c.CurrentExpense.ToString("C")</td>
                                <td class="text-end">@c.PreviousExpense.ToString("C")</td>
                                <td class="text-end @(c.ExpenseDiff <= 0 ? "text-success" : "text-danger")">
                                    @c.ExpenseDiff.ToString("C")
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Saldo</strong></td>
                                <td class="text-end"><strong>@c.CurrentBalance.ToString("C")</strong></td>
                                <td class="text-end"><strong>@c.PreviousBalance.ToString("C")</strong></td>
                                <td class="text-end @(c.BalanceDiff >= 0 ? "text-success" : "text-danger")">
                                    <strong>@c.BalanceDiff.ToString("C")</strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Grafer -->
<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h5>Utgifter per kategori</h5>
                @if (!Model.ChartData.Any())
                {
                    <p class="text-muted mb-0">Ingen utgiftsdata för vald period.</p>
                }
                else
                {
                    <canvas id="expenseChart" height="180"></canvas>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h5>Netto per dag</h5>
                <canvas id="trendChart" height="180"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Budget + Top 3 -->
<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h5>Budget vs utfall</h5>

                @if (!Model.BudgetRows.Any())
                {
                    <p class="text-muted mb-0">Ingen budget/utfall-data för vald period.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Kategori</th>
                                    <th class="text-end">Budget</th>
                                    <th class="text-end">Utfall</th>
                                    <th class="text-end">Kvar</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in Model.BudgetRows)
                            {
                                <tr>
                                    <td>@row.CategoryName</td>
                                    <td class="text-end">@row.Budget.ToString("C")</td>
                                    <td class="text-end">@row.Spent.ToString("C")</td>
                                    <td class="text-end @(row.Remaining < 0 ? "text-danger" : "text-success")">
                                        @row.Remaining.ToString("C")
                                    </td>
                                    <td>
                                        @if (row.Budget == 0)
                                        {
                                            <span class="badge bg-secondary">Ingen budget</span>
                                        }
                                        else if (row.OverBudget)
                                        {
                                            <span class="badge bg-danger">Över budget</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">OK</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="Budgets"
                       asp-action="Index"
                       asp-route-month="@Model.Month"
                       asp-route-year="@Model.Year">
                        Hantera budget
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h5>Top 3 största utgifter</h5>
                @if (!Model.TopExpenses.Any())
                {
                    <p class="text-muted mb-0">Inga utgifter för vald period.</p>
                }
                else
                {
                    <ol class="mb-0">
                        @foreach (var t in Model.TopExpenses)
                        {
                            <li class="mb-2">
                                <strong>@t.Description</strong> – @t.Amount.ToString("C")
                                <br />
                                <small class="text-muted">@t.Date.ToString("yyyy-MM-dd") · @t.Category?.Name</small>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>
</div>

<!-- Senaste transaktioner -->
<div class="row">
    <div class="col-lg-12 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Senaste transaktioner</h5>
                @if (!Model.Latest.Any())
                {
                    <p class="text-muted mb-0">Inga transaktioner i vald period.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var t in Model.Latest)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <div class="fw-semibold">@t.Description</div>
                                    <small class="text-muted">@t.Date.ToString("yyyy-MM-dd") · @t.Category?.Name</small>
                                </div>
                                <span class="badge @(t.IsIncome ? "bg-success" : "bg-danger")">
                                    @(t.IsIncome ? "+" : "-")@t.Amount.ToString("C")
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-2">
    <a class="btn btn-primary me-2" asp-controller="Transactions" asp-action="Index">Visa transaktioner</a>
    <a class="btn btn-outline-secondary me-2" asp-controller="Transactions" asp-action="Create">Ny transaktion</a>
    <a class="btn btn-outline-primary" asp-controller="Budgets" asp-action="Index" asp-route-month="@Model.Month" asp-route-year="@Model.Year">Budget</a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const expenseLabels = @Html.Raw(JsonSerializer.Serialize(Model.ChartLabels));
        const expenseData = @Html.Raw(JsonSerializer.Serialize(Model.ChartData));
        const trendLabels = @Html.Raw(JsonSerializer.Serialize(Model.TrendLabels));
        const trendData = @Html.Raw(JsonSerializer.Serialize(Model.TrendData));

        if (expenseData.length > 0) {
            new Chart(document.getElementById('expenseChart'), {
                type: 'doughnut',
                data: {
                    labels: expenseLabels,
                    datasets: [{ data: expenseData }]
                },
                options: {
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Netto per dag',
                    data: trendData,
                    tension: 0.25
                }]
            },
            options: {
                scales: { y: { beginAtZero: false } }
            }
        });
    </script>
}