@model BudgetApp.Models.Transaction
@{
    ViewData["Title"] = "Redigera transaktion";
}
<h1>Redigera transaktion</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Beskrivning</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Belopp</label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label">Datum</label>
        <input asp-for="Date" class="form-control" type="date" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Kategori</label>
        <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsIncome" class="form-check-input" />
        <label asp-for="IsIncome" class="form-check-label">Inkomst</label>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsRecurring" class="form-check-input" />
        <label asp-for="IsRecurring" class="form-check-label">Återkommande varje månad</label>
    </div>

    <div class="mb-3">
        <label asp-for="RecurringDayOfMonth" class="form-label">Dag i månaden</label>
        <input asp-for="RecurringDayOfMonth" type="number" min="1" max="28" class="form-control" />
        <span asp-validation-for="RecurringDayOfMonth" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
    <a asp-action="Index" class="btn btn-secondary">Avbryt</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}