@model BudgetApp.Controllers.QuickSetBudgetVm
@{
    ViewData["Title"] = "Snabbsätt budget";
}

<h1>Snabbsätt budget</h1>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="QuickSet" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-2 mb-3">
        <div class="col-md-2">
            <label asp-for="Month" class="form-label">Månad</label>
            <input asp-for="Month" class="form-control" min="1" max="12" />
        </div>
        <div class="col-md-2">
            <label asp-for="Year" class="form-label">År</label>
            <input asp-for="Year" class="form-control" min="2000" max="2100" />
        </div>
    </div>

    <div class="table-responsive mb-3">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Kategori</th>
                    <th class="text-end">Budget</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.Rows[i].CategoryName
                            <input asp-for="Rows[@i].CategoryId" type="hidden" />
                            <input asp-for="Rows[@i].CategoryName" type="hidden" />
                        </td>
                        <td class="text-end">
                            <input asp-for="Rows[@i].Amount" class="form-control text-end" />
                            <span asp-validation-for="Rows[@i].Amount" class="text-danger"></span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="submit" class="btn btn-primary">Spara alla</button>
    <a asp-action="Index" asp-route-month="@Model.Month" asp-route-year="@Model.Year" class="btn btn-secondary">Avbryt</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}